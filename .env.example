# Supabase (Project Settings > API). Service role key is server-only: never expose to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com). Verify maritimeexpoasia.com DNS before sending.
RESEND_API_KEY=
# Comma-separated recipients for new enquiry notices [TBC]
NOTIFY_EMAIL=
# Optional sender override
NOTIFY_FROM=Maritime Expo Asia <noreply@maritimeexpoasia.com>
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
